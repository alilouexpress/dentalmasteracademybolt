# Copy this file to .env and fill in real values.

# Frontend (Vite) — leave empty to use the local Vite proxy / same origin
VITE_API_URL=

# Backend (server)
# Set NODE_ENV=production on the production server
NODE_ENV=development
# Hostinger Business provides its own port for Node.js apps — set PORT to the
# value shown in hPanel > Node.js (fallback for local development is 4000).
PORT=4000
# REQUIRED in production, min 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d
# bcrypt cost factor (10-12 recommended)
BCRYPT_ROUNDS=12

# MySQL — on Hostinger Business, use the host/database/user/password created
# in hPanel > MySQL Databases. The MySQL host is usually `localhost` on shared
# hosting (NOT 127.0.0.1).
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=dental_admin
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=dental_master

# Auth cookie (httpOnly session). default: secure when NODE_ENV=production,
# sameSite=lax (recommended). Only set COOKIE_SAMESITE=none if the API is
# served from a different origin than the frontend (requires https).
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax

# CORS allow-list, comma-separated. Empty = same-origin only (recommended).
# CORS_ORIGIN=https://votre-domaine.com

# Set to true when the API runs behind a reverse proxy (Nginx) so
# rate limiting sees the real client IP.
# TRUST_PROXY=true

# The administrator account is provisioned by the server migration.
# New account creation is disabled.
